{
  "name": "no-lost-media-launcher",
  "private": true,
  "version": "0.1.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nlm/launcher",
    "build": "npm run build -w @nlm/launcher",
    "preview": "npm run preview -w @nlm/launcher",
    "catalog:sync": "node scripts/sync-no-lost-media-catalog.mjs",
    "tauri": "npm run tauri -w @nlm/launcher",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
