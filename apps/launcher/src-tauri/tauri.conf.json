{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "No Lost Media Launcher",
  "version": "0.1.3",
  "identifier": "media.nolost.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "No Lost Media Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "skipTaskbar": false,
        "backgroundColor": "#080b12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nolostmedia"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENUIyODdBMTEyQTFGMApSV1R3b1JLaGg3TFZCWkJjdEQ0VzVvZVB0dFBHNWVQbXpRQzZJYzZESXlLT0plbWZGRE9UTFdDdQo=",
      "endpoints": [
        "https://github.com/SarmentoCaio/No-Lost-Media-Launcher/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "shortDescription": "Launcher desktop oficial do No Lost Media",
    "longDescription": "Baixe, organize, configure e execute o acervo do No Lost Media no PC.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
